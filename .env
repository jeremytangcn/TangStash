# TangStash — local environment variables
#
# Used by `netlify dev` for local development (Netlify CLI loads this file
# automatically). It is NOT deployed to production — Netlify's build/runtime
# reads env vars from the site's own dashboard settings, not from this file.
# For the live site, set SITE_PASSWORD at:
#   Netlify dashboard → Site configuration → Environment variables

SITE_PASSWORD=Qwerty123!

# ---- Netlify Blobs local-dev fallback -------------------------------------
# netlify dev doesn't always auto-inject Blobs access locally even on a
# linked site ("The environment has not been configured to use Netlify
# Blobs..."). If you hit that error, fill these two in and restart
# netlify dev — netlify/functions/lib/inventory-helpers.js's getBlobStore()
# will use them instead of relying on auto-injection. Leave both blank once
# it's working automatically, or just leave them filled — either is fine,
# they're unused in production.
#
# NETLIFY_SITE_ID: already known from your `netlify status` output.
# NETLIFY_AUTH_TOKEN: generate one at
#   https://app.netlify.com/user/applications#personal-access-tokens
#   (User settings → Applications → New access token). Treat it like a
#   password — it's in .gitignore already, never commit it.

NETLIFY_SITE_ID=021a7491-1a8f-4725-ac6c-e2bf2393c881
NETLIFY_AUTH_TOKEN=nfp_R1x2HssUxGR7bGhm3jZQe4GM8cFCre8Y9852
